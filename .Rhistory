replace_taxa <- function(df, taxa_col = "taxa") {
lookup <- c(
"Ardea intermedia" = "Ardea plumifera"
)
# Ensure lookup is a named vector: names = old, values = new
stopifnot(is.character(lookup), !is.null(names(lookup)))
df[[taxa_col]] <- dplyr::if_else(
df[[taxa_col]] %in% names(lookup),
lookup[df[[taxa_col]]],
df[[taxa_col]]
)
df
}
