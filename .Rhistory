score_anthropogenic_habitat <- function(df,
species_cols = c("ScientificName",
"CommonName"))
{
library(dplyr)
library(stringr)
library(scales)
## ---- habitat score lookup ----
habitat_lookup <- c(
"pastureland"                                     = 2,
"plantations"                                      = 2,
"rural gardens"                                    = 2,
"urban areas"                                      = 3,
"degraded former forest"                           = 1,
"water storage areas (>8 ha)"                      = 2,
"ponds (<8 ha)"                                    = 1,
"aquaculture ponds"                                = 2,
"salt exploitation sites"                          = 1,
"excavations (open)"                               = 3,
"wastewater treatment areas"                       = 2,
"irrigated land"                                   = 2,
"seasonally flooded agricultural land"             = 1,
"canals & drainage channels"                       = 2,
"subterranean hydrological systems (human-made)"   = 3,
"marine anthropogenic structures"                  = 1,
"mariculture cages"                                = 2,
"marine/brackish-culture ponds"                    = 1,
"introduced vegetation"                            = 1
)
## ---- score + aggregate ----
scored <- df %>%
mutate(
habitat_clean = str_to_lower(.data[["HabitatsLevel2"]]),
habitat_score = habitat_lookup[habitat_clean],
habitat_score = replace_na(habitat_score, 0)
) %>%
group_by(across(all_of(species_cols))) %>%
summarise(
habitat_score_sum = sum(habitat_score, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
anthro_LogHabitat_scaled = rescale(log(habitat_score_sum + 1),
to = c(0, 1))
)
return(scored)
}
